<Window x:Class="ZgadnijLiczbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ZgadnijLiczbe"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="LightBlue">

    <Grid Margin="10">
        <StackPanel>

            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Text="GRA: ZGADNIJ LICZBĘ"
                Foreground="DarkBlue"
                />

            <TextBlock
                HorizontalAlignment="Center"
                Text="Komputer wylosował liczbę od 1 do 10. Spróbuj ją odgadnąć!"
                Margin="0 20 0 20"
                FontSize="13"
                /> 

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Center">
                
                <TextBlock
                    Text="Twoja liczba:"
                    FontSize="14"
                    Margin="0,0,5,0"/>

                <TextBox
                    x:Name="txtLiczba"
                    Width="60"
                    Height="22"
                    FontSize="14"
                    VerticalContentAlignment="Center"
                    TextAlignment="Center"/>

            </StackPanel>


            <Button
                x:Name="btnSprawdz"
                Content="SPRAWDŹ!"
                Width="100"
                Height="30"
                Margin="0 20 0 20"
                Background="LightGreen"
                FontWeight="Bold"
                Click="btnSprawdz_Click"/>

            <TextBlock
                x:Name="txtKomunikat"
                Text="Wprowadź liczbę od 1 do 10"
                FontWeight="Bold"
                FontSize="14"
                HorizontalAlignment="Center"/>


            <TextBox
                x:Name="txtWynik"
                Height="70"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Visible"
                Text="Rozpoczęto nową grę!"
                Margin="10 20 10 20"
                Padding="5"/>

            <Button
                x:Name="btnNowaGra"
                Content="NOWA GRA"
                Width="100"
                Height="30"
                Margin="0 20 0 20"
                Background="Orange"
                Click="btnNowaGra_Click"/>

        </StackPanel>

    </Grid>
</Window>
